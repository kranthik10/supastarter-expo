{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_SCHEME": "mobile-saas-dev"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "distribution": "internal"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_SCHEME": "mobile-saas-preview"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_SCHEME": "mobile-saas"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
