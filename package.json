{
  "name": "mobile-saas-starter",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --passWithNoTests",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:seed": "pnpm --filter @repo/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.18",
    "@types/react-native": "^0.73.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@paralleldrive/cuid2": "^2.3.1",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.5",
    "react-native": "0.86.2",
    "superjson": "^2.2.6",
    "zod": "^4.5.4"
  }
}
