{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build":     { "dependsOn": ["^build"], "outputs": ["dist/**", ".expo/**", "web-build/**"] },
    "dev":       { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "lint":      { "outputs": [] },
    "test":      { "dependsOn": ["^build"], "outputs": [] },
    "clean":     { "cache": false }
  }
}
